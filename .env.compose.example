# Copy to .env.compose for the Docker Compose home-runtime path.
# This file is topology/runtime configuration only.
# Keep secrets such as MYCELIS_API_KEY, DB_PASSWORD,
# MYCELIS_BREAK_GLASS_API_KEY, and MYCELIS_SEARXNG_SECRET in .env.

MYCELIS_BOOTSTRAP_TEMPLATE_ID=mycelis-runtime-core

POSTGRES_USER=mycelis
POSTGRES_DB=cortex

# Compose Core reaches the pgvector/pg16 service on its container address.
DB_HOST=postgres
DB_PORT=5432
DB_USER=mycelis
DB_NAME=cortex

NATS_URL=nats://nats:4222
MYCELIS_NATS_SERVICE_ID=mycelis-core

# The PostgreSQL service stores relational rows and vectors together in the
# postgres-data volume. Local Core reaches its published host port; Compose Core
# continues to use postgres:5432.
MYCELIS_COMPOSE_POSTGRES_PORT=15432
MYCELIS_COMPOSE_NATS_PORT=4222
MYCELIS_COMPOSE_NATS_MONITOR_PORT=8222
MYCELIS_COMPOSE_CORE_PORT=8081
MYCELIS_COMPOSE_INTERFACE_PORT=3000
MYCELIS_COMPOSE_SEARXNG_PORT=8088

# Default home-runtime posture uses a host Ollama instance.
# On Docker Desktop, host.docker.internal resolves automatically.
# On Linux Docker Engine, the compose file adds host-gateway for the core service.
MYCELIS_COMPOSE_OLLAMA_HOST=http://host.docker.internal:11434
MYCELIS_COMPOSE_OLLAMA_ENABLED=true

# Recommended on Windows hosts: keep Ollama above as the root for every profile.
# WSL vLLM can lock the WSL VM up under load; Windows Ollama avoids that.
# MYCELIS_ROOT_PROVIDER=ollama
#
# To reuse an existing local vLLM server, disable Ollama above and configure:
# MYCELIS_PROVIDER_VLLM_ENABLED=true
# MYCELIS_PROVIDER_VLLM_ENDPOINT=http://host.docker.internal:8000/v1
# MYCELIS_PROVIDER_VLLM_MODEL_ID=<exact id returned by /v1/models>
# MYCELIS_PROVIDER_VLLM_MAX_OUTPUT_TOKENS=512
# MYCELIS_PROVIDER_VLLM_TOKEN_BUDGET_PROFILE=conservative
# MYCELIS_ROOT_PROVIDER=vllm   # routes every agent type to vLLM (see below)
# If authentication is required, keep MYCELIS_TEXT_ENGINE_API_KEY in .env.
# This connects to an existing server; it does not install/start vLLM.
#
# Example: running all profiles on a local Qwen2.5-Coder-14B-AWQ vLLM server
# (16,384-token context window). `extended` sets a 2048-token output budget,
# leaving ~14k tokens for the system prompt, worker contract, and bounded
# history. Do not set MYCELIS_PROVIDER_VLLM_MAX_OUTPUT_TOKENS for this
# profile: an explicit value overrides TOKEN_BUDGET_PROFILE and would pin the
# smaller 512-token default from the commented block above.
# MYCELIS_COMPOSE_OLLAMA_ENABLED=false
# MYCELIS_PROVIDER_VLLM_ENABLED=true
# MYCELIS_PROVIDER_VLLM_ENDPOINT=http://host.docker.internal:8000/v1
# MYCELIS_PROVIDER_VLLM_MODEL_ID=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ  # exact /v1/models id; alias qwen2.5-coder also served
# MYCELIS_PROVIDER_VLLM_TOKEN_BUDGET_PROFILE=extended                # 2048 output tokens; leave MAX_OUTPUT_TOKENS unset
#
# Hosted variant: this local vLLM is the root model for every agent type.
# Routing precedence, highest first:
#   1. operator override: a non-empty MYCELIS_PROFILE_<NAME>_PROVIDER, or a
#      DB system_config role.<name> row;
#   2. MYCELIS_ROOT_PROVIDER (or root_provider in cognitive.yaml);
#   3. the profile defaults shipped in core/config/cognitive.yaml.
# So with MYCELIS_ROOT_PROVIDER=vllm, all seven profiles (admin/architect/chat/
# coder/creative/overseer/sentry) run on vLLM and the per-profile variables are
# optional — set one only to pin that profile elsewhere. Unset or empty means
# "no override". Leaving MYCELIS_ROOT_PROVIDER unset keeps the shipped
# defaults exactly. A root naming an unconfigured or disabled provider fails
# Core startup closed; there is no cross-boundary fallback.
# `uv run inv cognitive.status` prints Core's effective root and per-profile
# source (override | root | default) next to this configured (env) value.
# MYCELIS_ROOT_PROVIDER=vllm
# MYCELIS_PROFILE_CODER_PROVIDER=ollama   # optional: pin one profile elsewhere
# `deep` (4096 out) is only safe once the capability eval's long-prompt case
# shows real worker prompts stay <= 11k tokens; `conservative` (512 out) is
# too small for code/package generation. Cross-provider fallback for these
# profiles stays disabled by default (no silent reroute). An operator may opt
# in by adding an explicit, same-data-boundary `profile_fallbacks` list to
# core/config/cognitive.yaml (no env var for this yet) — a local_only profile
# must never list a leaves_org provider.

# The Core image includes npm/npx for curated stdio MCP servers. Keep automatic
# default MCP bootstrap disabled unless intentionally enabling that owned setup.
MYCELIS_DISABLE_DEFAULT_MCP_BOOTSTRAP=true

# Governed search provider. The Compose release path starts a self-hosted
# SearXNG service so Soma can use web_search without Brave tokens. Set this to
# disabled, local_sources, or local_api when an operator intentionally wants a
# different posture.
MYCELIS_SEARCH_PROVIDER=searxng
MYCELIS_SEARXNG_ENDPOINT=http://searxng:8080
MYCELIS_SEARXNG_PUBLIC_BASE_URL=http://localhost:8088/
MYCELIS_SEARCH_LOCAL_API_ENDPOINT=
MYCELIS_SEARCH_MAX_RESULTS=8
MYCELIS_SEARCH_ONLINE_ALLOWED=true
MYCELIS_SEARCH_APPROVAL_MODE=notify
MYCELIS_SEARCH_DISCLOSURE_MODE=notice_and_interpretation

CORS_ORIGIN=http://localhost:3000

# Output block storage mounted into Core at /data.
# Use local_hosted for Docker Compose or a Pinokio/local-media host directory.
# Use cluster_generated in Kubernetes/cluster docs where the chart PVC owns /data.
# When local_hosted, provide a real host directory path that Docker can mount.
# Relative paths are resolved from the repo root; ~ and environment variables are
# expanded by the Invoke compose task with Python pathlib before Compose runs.
MYCELIS_OUTPUT_BLOCK_MODE=local_hosted
MYCELIS_OUTPUT_HOST_PATH=./workspace/docker-compose/data
DATA_DIR=/data/artifacts
MYCELIS_WORKSPACE=/data/workspace

# Optional non-secret G4/E10 counting fixture endpoint (disabled when empty).
# Use a container-reachable URL; this does not authorize execution or create grants.
MYCELIS_COUNTING_ENDPOINT=

# Native code-context read-only repository mount for Core. Mounted at /repo
# (see docker-compose.yml) and read through MYCELIS_CODE_CONTEXT_ROOTS=/repo.
# Point this at a dedicated clean git worktree of dev with no .env, for example
# `git worktree add --detach ~/Projects/mycelisai-worktrees/code-context-readonly dev`,
# then set MYCELIS_CODE_CONTEXT_HOST_ROOT to that worktree path. Never point this
# at the main checkout: it holds .env. Leaving it unset mounts the empty,
# repo-owned placeholder ops/code-context/empty-root, so the stack still starts
# with no source tree exposed.
MYCELIS_CODE_CONTEXT_HOST_ROOT=

# B2 is disabled unless the task process sets MYCELIS_COMPOSE_FRAMEWORK_RUNS=1.
# Keep FRAMEWORK_RUNS_CORE_TOKEN, FRAMEWORK_RUNS_DB_USER/DB_PASSWORD/DB_NAME,
# and FRAMEWORK_RUNS_DATABASE_URL in .env, separate from Core credentials.
# The DSN must target framework-runs-postgres:5432 and match the dedicated DB.
# TLS SAN: framework-runs-control; private key must be readable by UID 1000.
# FRAMEWORK_RUNS_TLS_CERT_HOST_FILE=/absolute/operator/path/tls.crt
# FRAMEWORK_RUNS_TLS_KEY_HOST_FILE=/absolute/operator/path/tls.key
# FRAMEWORK_RUNS_TLS_CA_HOST_FILE=/absolute/operator/path/ca.crt
# Disposable proof: uv run inv lifecycle.first-boot-proof --isolated --framework-runs --build
